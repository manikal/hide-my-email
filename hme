#!/bin/bash
# hme — Generate Apple Hide My Email addresses from the terminal.
# Wrapper around hide_my_email.applescript for a clean CLI experience.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")" && pwd)"
APPLESCRIPT="$SCRIPT_DIR/hide_my_email.applescript"

# Colors
GREEN='\033[0;32m'
DIM='\033[2m'
RESET='\033[0m'

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
  echo "Usage: hme <label> [note]"
  echo ""
  echo "  Generate an Apple Hide My Email address and copy it to clipboard."
  echo ""
  echo "Examples:"
  echo "  hme \"Twitter\""
  echo "  hme \"Shopping\" \"For online orders\""
  exit 0
fi

email=$(osascript "$APPLESCRIPT" "$@")

# Partially mask the email: show first 3 chars of local part, mask the rest before @
local_part="${email%%@*}"
domain="${email#*@}"
masked="${local_part:0:3}$(printf '*%.0s' $(seq 1 $((${#local_part} - 3))))@${domain}"

echo -e "${GREEN}✓${RESET} ${masked} ${DIM}(copied to clipboard)${RESET}"
